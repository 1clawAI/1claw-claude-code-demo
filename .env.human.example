# Used ONLY by `npm run bootstrap`, run by a human. Never handed to either agent.
# Personal API key from the 1Claw dashboard (Settings → API keys).
ONECLAW_API_KEY=1ck_...
# Your 1Claw account password. Widening an agent's pay guardrails needs re-auth (X-Auth-Confirm).
ONECLAW_PASSWORD=
# Coinbase CDP API key for the mainnet x402 facilitator (verify + settle).
# Bootstrap writes these into the SELLER's 1Claw vault; they never touch seller/.env.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional
# ONECLAW_BASE_URL=https://api.1claw.co
# SELLER_PORT=4021
